`pragma protect end_protected
module FIFO_HS_Top (
  Data,
  WrClk,
  RdClk,
  WrEn,
  RdEn,
  Almost_Full,
  Q,
  Empty,
  Full
)
;
input [15:0] Data;
input WrClk;
input RdClk;
input WrEn;
input RdEn;
output Almost_Full;
output [31:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.FIFO_HS_Top  fifo_inst (
    .RdClk(RdClk),
    .WrClk(WrClk),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[15:0]),
    .Empty(Empty),
    .Almost_Full(Almost_Full),
    .Full(Full),
    .Q(Q[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* FIFO_HS_Top */
